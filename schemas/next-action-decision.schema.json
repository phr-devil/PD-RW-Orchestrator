{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Candidate Next Action Decision v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "from_task_id",
    "decision_type",
    "reason_codes",
    "suggested_capability",
    "recommended_agent_id",
    "declared_but_unavailable_agent_ids",
    "agent_selection_status",
    "source_claim_trusted",
    "independent_review_completed",
    "execution_authorized",
    "can_auto_dispatch",
    "author_decision_required_for_effects",
    "next",
    "authorization_status",
    "next_task"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "project_id": {
      "type": "string"
    },
    "from_task_id": {
      "type": "string"
    },
    "decision_type": {
      "enum": [
        "CONTINUE_SAME_AGENT",
        "SWITCH_AGENT",
        "INDEPENDENT_REVIEW",
        "REVISE_PLAN",
        "REQUEST_AUTHOR_DECISION",
        "RECONCILE",
        "HOLD",
        "READY_FOR_NEXT_STAGE",
        "VERIFY_EXISTING_SCOPE",
        "REVIEW_OUTCOME_PENDING"
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "suggested_capability": {
      "type": "string"
    },
    "recommended_agent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "declared_but_unavailable_agent_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "agent_selection_status": {
      "enum": [
        "VERIFIED_REAL_AGENT",
        "NOT_CONNECTED"
      ]
    },
    "source_claim_trusted": {
      "const": false
    },
    "independent_review_completed": {
      "const": false
    },
    "execution_authorized": {
      "const": false
    },
    "can_auto_dispatch": {
      "const": false
    },
    "author_decision_required_for_effects": {
      "type": "boolean"
    },
    "next": {
      "type": "string"
    },
    "authorization_status": {
      "enum": [
        "DENIED",
        "SCOPE_NOT_YET_VERIFIED",
        "EXISTING_GRANT_VERIFIED",
        "NEW_GRANT_REQUIRED",
        "NOT_REQUIRED_FOR_PROPOSAL"
      ]
    },
    "next_task": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "NextTaskProposal v1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status",
        "proposal_id",
        "project_id",
        "from_task_id",
        "decision_type",
        "task_type",
        "capability",
        "objective",
        "acceptance_criteria",
        "stop_conditions",
        "original_protocol_refs",
        "original_evidence_refs",
        "unverified_agent_artifact_refs",
        "prior_authorization_refs_unverified",
        "prior_effects_for_scope_review_only",
        "required_effects",
        "budget",
        "authorization_verified",
        "scientific_completion_verified",
        "can_dispatch"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "status": {
          "const": "PROPOSED_SOURCE_REVIEW_REQUIRED"
        },
        "proposal_id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "from_task_id": {
          "type": "string",
          "minLength": 1
        },
        "decision_type": {
          "type": "string"
        },
        "task_type": {
          "type": "string"
        },
        "capability": {
          "type": "string"
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "stop_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "original_protocol_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "original_evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unverified_agent_artifact_refs": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "prior_authorization_refs_unverified": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prior_effects_for_scope_review_only": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_effects": {
          "type": "array",
          "maxItems": 0
        },
        "budget": {
          "type": "object",
          "maxProperties": 0
        },
        "authorization_verified": {
          "const": false
        },
        "scientific_completion_verified": {
          "const": false
        },
        "can_dispatch": {
          "const": false
        }
      }
    }
  }
}
