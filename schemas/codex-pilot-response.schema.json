{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex pilot read-only analysis output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "observations",
    "limitations",
    "next_actions"
  ],
  "properties": {
    "summary": {
      "type": "string"
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim",
          "source_refs",
          "limitations"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
