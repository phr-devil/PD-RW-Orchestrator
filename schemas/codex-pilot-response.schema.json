{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex pilot read-only analysis output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "observations",
    "limitations",
    "next_actions"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "observations": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim",
          "source_refs",
          "limitations"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "source_refs": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "maxLength": 200
            }
          },
          "limitations": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "maxLength": 400
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "maxLength": 400
      }
    },
    "next_actions": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string",
        "maxLength": 400
      }
    }
  }
}
