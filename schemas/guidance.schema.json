{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Guidance v1",
  "type": "object",
  "required": [
    "id",
    "level",
    "source",
    "text",
    "task_types"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "enum": [
        "requirement",
        "must_consider",
        "recommendation",
        "experience"
      ]
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "task_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "deny_effects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
