{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Registry Entry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "adapter",
    "capabilities",
    "ready",
    "priority"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "adapter": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "ready": {
      "type": "boolean"
    },
    "priority": {
      "type": "integer"
    }
  }
}
