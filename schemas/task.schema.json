{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskPacket v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "project_id",
    "task_type",
    "objective"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "task_type": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "protocol_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "authorization_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "required_effects": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "capability": {
      "type": "string"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "max_model_calls": {
          "type": "integer",
          "minimum": 0
        },
        "max_wall_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
